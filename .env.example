# Copy this file to .env and adjust. Every value has a sensible default.

# Ollama (https://ollama.com) writes the answers locally. Run `ollama pull qwen3.5:4b` first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
LLM_TIMEOUT=180

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=350
CHUNK_OVERLAP=60
TOP_K=5
# Gate: answer if a chunk reaches MIN_SIMILARITY (meaning) or MIN_KEYWORD (exact rare words)
MIN_SIMILARITY=0.645
MIN_KEYWORD=0.70
HYBRID=true
