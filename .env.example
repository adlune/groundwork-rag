# Copy this file to .env and adjust. Every value has a sensible default.

# Which LLM writes the answers: "ollama" (local, free) or "anthropic" (Claude API)
LLM_PROVIDER=ollama

# Ollama (https://ollama.com) - run `ollama pull qwen3.5:4b` first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Anthropic - only needed when LLM_PROVIDER=anthropic (install with: uv sync --extra anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=350
CHUNK_OVERLAP=60
TOP_K=5
MIN_SIMILARITY=0.55
